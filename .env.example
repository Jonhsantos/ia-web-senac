# Chave da API do Google Gemini (obrigatória para o endpoint /chat)
# Obtenha em: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=sua_chave_aqui

# Modelo usado pelo serviço
GEMINI_MODEL=gemini-3.1-flash-lite

# Tempo limite de resposta do Gemini, em segundos
GEMINI_TIMEOUT_SECONDS=30

# Quantidade máxima de documentos enviados como contexto por pergunta
GEMINI_MAX_DOCUMENTS=4

# Nome e versão exibidos em GET /
APP_NAME=Assistente Automotivo
APP_VERSION=1.0.0

# Resposta usada quando a informação não existe na base de conhecimento
FALLBACK_ANSWER=Não encontrei essa informação na base de conhecimento disponível.